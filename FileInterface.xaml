<UserControl x:Class="Paradox_Editor.FileInterface"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Paradox_Editor"
             mc:Ignorable="d" 
             d:DesignHeight="280" d:DesignWidth="368" AllowDrop="True" Focusable="True">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="55*"/>
            <ColumnDefinition Width="255*"/>
            <ColumnDefinition Width="58*"/>

        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="28"/>
            <RowDefinition Height="19"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="36*"/>
            <RowDefinition Height="67*"/>
            <RowDefinition Height="17*"/>
        </Grid.RowDefinitions>

        <TextBlock Name="PROVIDBOX" Text="PR-ID" Grid.Row="1" Grid.Column="0"
                 HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Arial Black"
                 Background="{x:Null}" Foreground="Black" Height="16"
                 TextAlignment="Center" FontSize="10" Margin="0,5,0,0"/>

        <TextBlock Name="NAMEBOX" Text="Province Name" Grid.Row="1" Grid.Column="1"
                 HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="Arial Black"
                 Background="{x:Null}" Foreground="Black" Height="16"
                 Width="252" TextAlignment="Center" FontSize="11"/>

        <Button Grid.Column="2" BorderBrush="{x:Null}" Grid.RowSpan="2" Grid.Row="0" BorderThickness="2,1,0,1" Margin="36,20,5,10"
                Padding="1,1,1,1" Background="{x:Null}" Click="ExitClicked">
            <Image Source="/Preloaded_Assets/VIC2/Icons/VIC2_Exit.png" Stretch="Uniform" Margin="0,0,0,0"/>
        </Button>


        <ScrollViewer Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Grid.RowSpan="3" HorizontalAlignment="Left" Width="300" Margin="35,10,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="25"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="RGB" Grid.Row="0" Grid.Column="0" FontFamily="Arial"
                         Background="{x:Null}" Foreground="Black"
                         Height="16" TextAlignment="Center" FontSize="14"
                         Focusable="False" HorizontalAlignment="Left"/>
                <TextBlock x:Name="COLORRGB" Text="255,255,255" Grid.Column="1" Grid.Row="0"
                         FontFamily="Arial" Background="{x:Null}" Foreground="Black"
                         Height="20" TextAlignment="Center" FontSize="14" Margin="-65,0,-75,0"/>

                <TextBlock Text="Owner" Grid.Row="1" Grid.Column="0" FontFamily="Arial"
                         Background="{x:Null}" Foreground="Black"
                         Height="16" TextAlignment="Center" FontSize="14"
                         Focusable="False" HorizontalAlignment="Left"/>
                <TextBox x:Name="OWNERBOX" Text="FRA" Grid.Row="1" Grid.Column="1" FontFamily="Arial"
                         Background="{x:Null}" BorderBrush="{x:Null}" Foreground="Black"
                         Height="16" TextAlignment="Center" FontSize="14" IsTabStop="False"/>

                <TextBlock Text="Controller" Grid.Row="2" Grid.Column="0" FontFamily="Arial"
                         Background="{x:Null}" Foreground="Black"
                         Height="16" TextAlignment="Center" FontSize="14"
                         Focusable="False" HorizontalAlignment="Left"/>
                <TextBox x:Name="CONTROLLERBOX" Text="FRA" Grid.Row="2" Grid.Column="1" FontFamily="Arial"
                         Background="{x:Null}" BorderBrush="{x:Null}" Foreground="Black"
                         Height="16" TextAlignment="Center" FontSize="14" IsTabStop="False"/>

                <TextBlock Text="Core(s)" Grid.Row="3" Grid.Column="0" FontFamily="Arial"
                         Background="{x:Null}" Foreground="Black"
                         Height="16" TextAlignment="Center" FontSize="14"
                         Focusable="False" HorizontalAlignment="Left"/>
                
                
                <!--This datagrid is a pain. Loading list of cores into.-->
                <DataGrid x:Name="COREGRID" Grid.Column="1" Grid.RowSpan="2" Grid.Row="3"
                          Background="{x:Null}" BorderBrush="{x:Null}" AlternationCount="2" Width="170"
                          Margin="0,0,0,-149" HorizontalAlignment="Center"
                          HorizontalContentAlignment="Center" Focusable="False" AllowDrop="False"
                          SelectionMode="Single" HeadersVisibility="None"
                          ItemsSource="{Binding TestCoreList}">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="TAG"/>
                    </DataGrid.Columns>

                    <TextBox Text="BUR" FontSize="14" FontFamily="Arial"
                                  HorizontalAlignment="Center"/>
                    <TextBox Text="BUR" FontSize="14" FontFamily="Arial"
                                  HorizontalAlignment="Center"/>
                    <TextBox Text="BUR" FontSize="14" FontFamily="Arial"
                                  HorizontalAlignment="Center"/>
 

                </DataGrid>

                <!-- DataGrid of death Ends Here.-->


            </Grid>

        </ScrollViewer>



        <Image x:Name="background" Source="/Preloaded_Assets/VIC2/Images/provinceInterface.png"
               Grid.RowSpan="6" Grid.ColumnSpan="3" Stretch="Fill" Panel.ZIndex="-1"/>
    </Grid>

</UserControl>
