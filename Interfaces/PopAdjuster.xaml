<UserControl x:Class="Paradox_Editor.Interfaces.PopAdjuster"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Paradox_Editor.Interfaces"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="White">
        <TextBlock Text="POPs to Affect:" VerticalAlignment="Top" FontWeight="Bold" Grid.Row="0" Margin="20,0,0,0"/>
        <Label BorderBrush="Gray" BorderThickness="1" Width="200" Height="200" HorizontalAlignment="Left" Margin="20,20,10,10" Grid.Row="0">
            <Grid>
                <TextBlock Text="Culture:" VerticalAlignment="Top" FontWeight="Bold" Grid.Row="0" Margin="10,0,0,0"/>
                <TextBox Name="cultureBox" Grid.Row="0" Grid.Column="1" Height="25" VerticalAlignment="Top"/>
                <TextBlock Text="Religion:" VerticalAlignment="Top" FontWeight="Bold" Grid.Row="1" Margin="10,0,0,0"/>
                <TextBox Name="religionBox" Grid.Row="1" Grid.Column="1" Height="25" VerticalAlignment="Top"/>
                <TextBlock Text="Types:" VerticalAlignment="Top" FontWeight="Bold" Grid.Row="2" Margin="10,0,0,0"/>
                <TextBox Name="typesBox" Grid.Row="2" Grid.Column="1" Height="25" VerticalAlignment="Top" Background="Red"/>
                <TextBox Name="typesBoxLarge" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Height="65" FontSize="10" VerticalAlignment="Top" Background="White" TextWrapping="Wrap"/>


                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="70"/>
                </Grid.RowDefinitions>

            </Grid>

        </Label>
        <TextBlock Text="Convert To:" VerticalAlignment="Top" HorizontalAlignment="Left" Grid.Column="1" FontWeight="Bold" Grid.Row="0" Margin="0,0,0,0"/>
        <Label BorderBrush="Gray" BorderThickness="1" Width="160" Grid.Column="1" HorizontalAlignment="Left" Margin="0,20,10,10" Grid.Row="0">
            
        </Label>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="40"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
    </Grid>
</UserControl>
