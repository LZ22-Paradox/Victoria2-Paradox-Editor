<UserControl x:Class="Paradox_Editor.Interfaces.PopAdjuster"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Paradox_Editor.Interfaces"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="900" Width="910">
    <Grid Background="White">
        <TextBlock Text="POPs to Affect:" VerticalAlignment="Top" FontWeight="Bold" Grid.Row="0" Margin="20,0,0,0"/>
        <!--#region Pops to Affect Panel-->
        <Label BorderBrush="Gray" BorderThickness="1" Width="200" Height="Auto" HorizontalAlignment="Left" Margin="20,20,10,0" Grid.Row="0">
            <Grid>
                <TextBlock Text="Culture:" VerticalAlignment="Top" FontWeight="Bold" Grid.Row="0" Margin="10,0,0,0"/>
                <TextBox Name="cultureBox" Grid.Row="0" Grid.Column="1" Height="25" VerticalAlignment="Top"/>
                <TextBlock Text="Religion:" VerticalAlignment="Top" FontWeight="Bold" Grid.Row="1" Margin="10,0,0,0"/>
                <TextBox Name="religionBox" Grid.Row="1" Grid.Column="1" Height="25" VerticalAlignment="Top"/>
                <TextBlock Text="Types:" VerticalAlignment="Top" FontWeight="Bold" Grid.Row="2" Margin="10,0,0,0"/>
                <Button Name="typesButton" Content="All Pop Types!" Click="typesButton_Click" Grid.Row="2" Grid.Column="1" Height="25" VerticalAlignment="Top" Background="LightGray"/>
                <TextBox Name="typesBoxLarge" Text="aristocrats; artisans; bureaucrats; capitalists; clergymen; clerks; craftsmen; farmers; labourers; officers; slaves; soldiers; serfs" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Height="70" FontSize="10" VerticalAlignment="Top" Background="White" TextWrapping="Wrap"/>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="70"/>
                </Grid.RowDefinitions>
            </Grid>
        </Label>
        <!--#endregion-->

        <TextBlock Text="Convert To:" VerticalAlignment="Top" HorizontalAlignment="Left" Grid.Column="1" FontWeight="Bold" Grid.Row="0" Margin="0,0,0,0"/>
        <!--#region Convert-To Panel-->
        <Label BorderBrush="Gray" BorderThickness="1" Width="200" Grid.Column="1" HorizontalAlignment="Left" Margin="0,20,10,0" Grid.Row="0">
            <Grid>
                <TextBlock Text="Culture:" VerticalAlignment="Top" FontWeight="Bold" Grid.Row="0" Margin="10,0,0,0"/>
                <TextBox Name="cultureSpecifier" Grid.Row="0" Grid.Column="1" Height="25" VerticalAlignment="Top"/>
                <TextBlock Text="Religion:" VerticalAlignment="Top" FontWeight="Bold" Grid.Row="1" Margin="10,0,0,0"/>
                <TextBox Name="religionSpecifier" Grid.Row="1" Grid.Column="1" Height="25" VerticalAlignment="Top"/>
                <TextBlock Text="Convert %:" VerticalAlignment="Top" FontWeight="Bold" Grid.Row="2" Margin="10,0,0,0" TextWrapping="Wrap"/>
                <TextBox Name="conversionMultiplier" Text="100" Grid.Row="2" Grid.Column="1" Height="25" VerticalAlignment="Top"/>
                <TextBlock Text="POP Size %:" VerticalAlignment="Top" FontWeight="Bold" Grid.Row="3" Margin="10,0,0,0" TextWrapping="Wrap"/>
                <TextBox Name="popsizeMultiplier" Text="100" Grid.Row="3" Grid.Column="1" Height="25" VerticalAlignment="Top"/>
                <TextBlock Text="Type:" VerticalAlignment="Top" FontWeight="Bold" Grid.Row="4" Margin="10,0,0,0" TextWrapping="Wrap"/>
                <TextBox Name="popTypeBox" Text="" Grid.Row="4" Grid.Column="1" Height="25" VerticalAlignment="Top"/>
                <CheckBox Name="deletePopsCheckbox" Panel.ZIndex="1" Checked="deletePopsCheckbox_Checked" IsChecked="False" Grid.Row="4" VerticalAlignment="Bottom" Margin="0,0,0,-3"/>
                <TextBlock Text="Delete POPs?" VerticalAlignment="Bottom" FontWeight="Bold" Grid.ColumnSpan="2" Grid.Row="4" Margin="20,0,0,-3" TextWrapping="Wrap"/>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                </Grid.RowDefinitions>
            </Grid>
        </Label>
        <!--#endregion-->

        <TextBlock Text="Add POPs:" VerticalAlignment="Top" FontWeight="Bold" Grid.Row="0" Grid.Column="2"/>
        <!--#region Add-Pop Panel-->
        <Label BorderBrush="Gray" BorderThickness="1" Width="200" Grid.Column="2" HorizontalAlignment="Left" Margin="0,20,0,50" Grid.Row="0">
            <Grid>
                <TextBlock Text="Culture:" VerticalAlignment="Top" FontWeight="Bold" Grid.Row="0" Margin="10,0,0,0"/>
                <TextBox Grid.Row="0" Grid.Column="1" Height="25" VerticalAlignment="Top"/>
                <TextBlock Text="Religion:" VerticalAlignment="Top" FontWeight="Bold" Grid.Row="1" Margin="10,0,0,0"/>
                <TextBox Grid.Row="1" Grid.Column="1" Height="25" VerticalAlignment="Top"/>
                <TextBlock Text="Size:" VerticalAlignment="Top" FontWeight="Bold" Grid.Row="2" Margin="10,0,0,0" TextWrapping="Wrap"/>
                <TextBox Text="" Grid.Row="2" Grid.Column="1" Height="25" VerticalAlignment="Top"/>
                <TextBlock Text="Type:" VerticalAlignment="Top" FontWeight="Bold" Grid.Row="3" Margin="10,0,0,0" TextWrapping="Wrap"/>
                <TextBox Text="" Grid.Row="3" Grid.Column="1" Height="25" VerticalAlignment="Top"/>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                </Grid.RowDefinitions>
            </Grid>
        </Label>
        <!--#endregion-->

        <TextBlock Text="Filter POP Files:" VerticalAlignment="Top" FontWeight="Bold" Grid.Row="0" Grid.Column="3" Margin="10,0,0,0"/>
        <!--#region Filter Files Panel-->
        <Label BorderBrush="Gray" BorderThickness="1" Width="250" Grid.Column="3" HorizontalAlignment="Left" Margin="10,20,10,100" Grid.Row="0">
            <Grid>
                <ComboBox Name="tagSpecifierCombobox" SelectedIndex="0" Height="25" Width="150" HorizontalAlignment="Left" VerticalAlignment="Top" Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0">
                    <ComboBoxItem Content="Owner"/>
                    <ComboBoxItem Content="Controller"/>
                    <ComboBoxItem Content="Core"/>
                </ComboBox>
                <TextBlock Text="Tag:" VerticalAlignment="Top" FontWeight="Bold" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" Margin="10,0,0,0"/>
                <TextBox Name="tagBox" Text="" Grid.Row="0" Grid.Column="1" Height="20" Width="40" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,20,0"/>

                <TextBlock Text="Continent:" VerticalAlignment="Top" FontWeight="Bold" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Left" Margin="10,0,0,0"/>
                <ComboBox Name="continentsComboBox" SelectedIndex="0" Height="25" Width="130" HorizontalAlignment="Right"
                          VerticalAlignment="Top" Grid.ColumnSpan="2" Grid.Row="1" Margin="0,0,20,0">
                </ComboBox>
                
                <Button Content="Add to List" VerticalAlignment="Top" Width="80" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Right" Margin="0,0,20,0"/>



                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                </Grid.RowDefinitions>
            </Grid>
        </Label>
        <!--#endregion-->

        <Button x:Name="goButton" Click="goButton_Click" Content="Convert!" HorizontalAlignment="Right" Margin="0,0,10,0" Grid.Row="1" Grid.Column="1" Width="60" Height="20"/>
        <Button x:Name="clearList" Panel.ZIndex="1" Click="clearList_Click" Grid.ColumnSpan="2" Content="Clear List" HorizontalAlignment="Right" Margin="0,0,10,0" Grid.Row="1" Grid.Column="2" Width="60" Height="20"/>

        <!--#region Log Panels-->
        <TextBlock Text="Stack Log:" VerticalAlignment="Bottom" FontWeight="Bold" Grid.Row="1" Grid.Column="0" Margin="20,0,0,0"/>
        <TextBox Name="outputLogBox" Height="200" VerticalAlignment="Top" AllowDrop="False" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="20,0,10,0">
        </TextBox>
        <TextBlock Text="Provinces Being Edited:" VerticalAlignment="Bottom" FontWeight="Bold" Grid.Row="1" Grid.Column="2" Margin="0,0,0,0"/>

        <!--Feature is Unfinished-->
        <TextBox Name="provincesList" Height="200" VerticalAlignment="Top" AllowDrop="False" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                Grid.Row="2" Grid.Column="2" Margin="0,0,10,0"  Grid.ColumnSpan="2">
        </TextBox>
        <!--#endregion-->

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="235"/>
            <RowDefinition Height="30"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
    </Grid>
</UserControl>
