<UserControl x:Class="Paradox_Editor.MapModesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Paradox_Editor"
             mc:Ignorable="d">

    <Grid>
        <Canvas Background="#FF494949" Height="50" Width="200" Margin="0,0,0,0">
            <Button Name="PoliticalButton" Height="25" Width="30" Click="mapmodeButton_Political_Click" Margin="5,0,0,0" Grid.Column="1" Background="{x:Null}" BorderBrush="{x:Null}">
                <Image x:Name="mapmodeButton_Political" Source="/Preloaded_Assets/VIC2/Icons/mapmode_PoliticalOff.png" Stretch="Fill"/>
            </Button>

            <Button Name="ProvincesButton" Height="25" Width="30" Click="mapmodeButton_Provinces_Click" Margin="35,0,0,0" Grid.Column="1" BorderBrush="{x:Null}" Background="{x:Null}">
                <Image x:Name="mapmodeButton_Provinces" Source="/Preloaded_Assets/VIC2/Icons/mapmode_ProvincesOff.png" Stretch="Fill"/>
            </Button>

            <Button Name="TerrainButton" Height="25" Width="30" Click="mapmodeButton_Terrain_Click" Margin="65,0,0,0" Grid.Column="1" Background="{x:Null}" BorderBrush="{x:Null}">
                <Image x:Name="mapmodeButton_Terrain" Source="/Preloaded_Assets/VIC2/Icons/mapmode_TerrainOff.png" Stretch="Fill"/>
            </Button>

        </Canvas>
    </Grid>
</UserControl>
