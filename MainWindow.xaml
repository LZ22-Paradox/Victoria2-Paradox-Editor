<Window
    xmlns:local="clr-namespace:Paradox_Editor"
    x:Class="Paradox_Editor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wf="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d"
        Title="Z-22 Paradox Map Editor" Height="700" Width="1200"
        UseLayoutRounding="True" WindowStartupLocation="CenterScreen" Loaded="MainWindow_Load"
        DataContext="{Binding RelativeSource={RelativeSource Self}}">

    <Window.Background>
        <ImageBrush>
            <ImageBrush.ImageSource>
                <BitmapImage UriSource="/Preloaded_Assets/VIC2/Images/main_bg.png"/>
            </ImageBrush.ImageSource>
        </ImageBrush>
    </Window.Background>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="mainWindowGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="6*"/>
            <RowDefinition Height="100*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270*"/>
            <ColumnDefinition Width="955*"/>
        </Grid.ColumnDefinitions>

        <local:MapModesControl x:Name="mapModeButtons" VerticalAlignment="Bottom" HorizontalAlignment="Right"
        Margin="0,0,18,15" Grid.Column="1" Panel.ZIndex="2" Height="64" Width="212" Grid.Row="1"/>

        <local:MapViewer x:Name="mapViewer" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
         Grid.Column="1" Panel.ZIndex="0" Grid.Row="1" Grid.ColumnSpan="1" Margin="0,0,15,10"/>

        <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Height="270" Width="372" Panel.ZIndex="5" >
            <behaviors:Interaction.Behaviors>
                <behaviors:MouseDragElementBehavior ConstrainToParentBounds="True"/>
            </behaviors:Interaction.Behaviors>
            <local:ProvinceInterface x:Name="ProvinceInterface" Visibility="Visible" HorizontalAlignment="Center"  VerticalAlignment="Top"
        Grid.Column="1" Grid.Row="1" Panel.ZIndex="3"  Height="270" Width="368" Grid.RowSpan="2" Grid.ColumnSpan="2"/>
        </Grid>
        

        <TextBox Name="TESTBOX" Text="TEST" Grid.Column="1" VerticalAlignment="Top" Background="Purple" Width="200" Panel.ZIndex="2" Height="40" Margin="400,25,0,0" Grid.Row="1"/>

        <Button x:Name="button" Content="SELECT MOD FOLDER" HorizontalAlignment="Center" VerticalAlignment="Top"
        Width="150" Height="25" Click="SelectMasterFolder_Click" Margin="0,12,0,0" Grid.Column="1" Panel.ZIndex="1" Grid.RowSpan="2"/>

        <Button x:Name="game_launch" Content="LAUNCH GAME" HorizontalAlignment="Right" VerticalAlignment="Top"
        Width="100" Height="20" Margin="0,15,17,0" Grid.Column="1" Panel.ZIndex="1" Grid.RowSpan="2"/>
        <!--Click does nothing at the moment-->


        <DataGrid x:Name="fileListView" Margin="20,15,5,10" AlternatingRowBackground="#FFE2E2E2"
                  ItemsSource="{Binding ProvinceData, Mode=TwoWay}" SelectedItem="{Binding SelectedItem}"
                  AutoGenerateColumns="False" CanUserAddRows="False" Visibility="Visible"
                  Grid.Column="0" Grid.ColumnSpan="1"  Grid.RowSpan="2">
            <DataGrid.Columns>
                <DataGridTextColumn x:Name="Column1" Header="ID" Width="40" Binding="{Binding ProvinceID, UpdateSourceTrigger=PropertyChanged}"/>
                <DataGridTextColumn x:Name="Column2" Header="Name" Width="120" Binding="{Binding ProvinceName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <DataGridTemplateColumn x:Name="Column3" Header="Open File" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Open" Height="18" Width="55" Click="OpenFileFromList"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <ComboBox x:Name="GameSelectDropdown"
                  HorizontalAlignment="Left" Grid.Row="0" Grid.Column="1" Margin="15,12,0,0"
                  VerticalAlignment="Top" Width="150" SelectedIndex="0" SelectionChanged="SelectGame" Grid.RowSpan="2" Height="22">
            <ListBoxItem x:Name="Vic2" Content="N/A">
            </ListBoxItem>
            <ListBoxItem Content="Victoria II" FontFamily="18thCentury" FontSize="20" FontWeight="Bold">
                <ListBoxItem.Background>
                    <ImageBrush ImageSource="/Preloaded_Assets/BackgroundSelectVIC2.png" Stretch="Fill"/>
                </ListBoxItem.Background>
            </ListBoxItem>
            <ListBoxItem x:Name="Europa4" Content="Europa Universalis IV" Foreground="White" FontFamily="Italianate" FontSize="14">
                <ListBoxItem.Background>
                    <ImageBrush ImageSource="/Preloaded_Assets/BackgroundSelectEU4.png" Stretch="Fill"/>
                </ListBoxItem.Background>
            </ListBoxItem>
        </ComboBox>


        <Expander x:Name="ControlsExpander" Grid.Column="1" Grid.Row="0" VerticalAlignment="Top" Header="Controls"
                  Height="200" Margin="0,12,20,0" Width="200" HorizontalAlignment="Right" IsExpanded="False" Panel.ZIndex="2" Grid.RowSpan="2">
            <Grid Background="#FFE5E5E5">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock Text="Pan Map" Grid.Row="0" FontSize="12"/>
                <TextBlock Text="Left Click or Middle Mouse Button" FontSize="10" Grid.Row="1" FontStyle="Oblique"/>
                <TextBlock Text="Scroll Left/Right" Grid.Row="2" FontSize="12"/>
                <TextBlock Text="Shift + ScrollWheel" FontSize="10" Grid.Row="3" FontStyle="Oblique"/>
                <TextBlock Text="Scroll Up/Down" Grid.Row="4" FontSize="12"/>
                <TextBlock Text="Control + ScrollWheel" FontSize="10" Grid.Row="5" FontStyle="Oblique"/>
                <TextBlock Text="Zoom In/Out" Grid.Row="6" FontSize="12"/>
                <TextBlock Text="ScrollWheel" FontSize="10" Grid.Row="7" FontStyle="Oblique"/>
                <TextBlock Text="More User Convienence Controls Are Planned" FontSize="8" Grid.Row="8" FontWeight="Bold" TextAlignment="Center"/>
            </Grid>
        </Expander>

        <ComboBox x:Name="ControlMode" HorizontalAlignment="Left" Grid.Column="1" ToolTip="Settings for program control scheme." Margin="178,12,0,0" VerticalAlignment="Top" Width="150" SelectedIndex="0" SelectionChanged="ChangeControlScheme" Grid.RowSpan="2" Height="22">
            <ListBoxItem x:Name="Mode_Classic" Content="Classic"/>
            <ListBoxItem x:Name="Mode_Modern" Content="Modern"/>
            <ListBoxItem x:Name="Mode_PaintDotNet" Content="Paint.NET"/>

        </ComboBox>


    </Grid>
</Window>
