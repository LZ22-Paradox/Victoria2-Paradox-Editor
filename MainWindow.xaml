<Window DataContext="{Binding this}"
    xmlns:local="clr-namespace:Paradox_Editor"
    x:Class="Paradox_Editor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wf="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Z-22 Paradox Map Editor" Height="700" Width="1200" UseLayoutRounding="True" WindowStartupLocation="CenterScreen" Loaded="MainWindow_Load">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="mainWindowGrid">
        <Grid.RowDefinitions>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270*"/>
            <ColumnDefinition Width="955*"/>
        </Grid.ColumnDefinitions>
        <Button x:Name="button" Content="Load Filepath" HorizontalAlignment="Left" VerticalAlignment="Top"
        Width="86" Height="27" Click="SelectMasterFolder_Click" Margin="98,0,0,0"/>



        <local:MapModesControl x:Name="mapModeButtons" Margin="700,600,0,0" Grid.Column="1" Panel.ZIndex="2">
        </local:MapModesControl>

        <DataGrid x:Name="fileListView" Margin="0,25,4,0" AlternatingRowBackground="#FFE2E2E2" ItemsSource="{Binding Path=FilePaths}" SelectedItem="{Binding SelectedItem}" AutoGenerateColumns="False" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn/>
                <DataGridTextColumn x:Name="Column1" Header="ID" Width="40" Binding="{Binding ID}"/>
                <DataGridTextColumn x:Name="Column2" Header="Name" Width="105" Binding="{Binding ProvinceName}"/>
                <DataGridTemplateColumn x:Name="Column3" Header="Open File" Width="61">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Open" Height="18" Width="55" Click="button_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <ContentPresenter Margin="0,0,0,660" Content="/provinces.png" Grid.Column="1"/>

        <Expander x:Name="expander" Grid.Column="1" Header="Controls" Height="200" Margin="700,0,0,480" Width="200" IsExpanded="False" Panel.ZIndex="2">
            <Grid Background="#FFE5E5E5">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock Text="Pan Map" Grid.Row="0" FontSize="12"/>
                <TextBlock Text="Left Click or Middle Mouse Button" FontSize="10" Grid.Row="1" FontStyle="Oblique"/>
                <TextBlock Text="Scroll Left/Right" Grid.Row="2" FontSize="12"/>
                <TextBlock Text="Shift + ScrollWheel" FontSize="10" Grid.Row="3" FontStyle="Oblique"/>
                <TextBlock Text="Scroll Up/Down" Grid.Row="4" FontSize="12"/>
                <TextBlock Text="Control + ScrollWheel" FontSize="10" Grid.Row="5" FontStyle="Oblique"/>
                <TextBlock Text="Zoom In/Out" Grid.Row="6" FontSize="12"/>
                <TextBlock Text="ScrollWheel" FontSize="10" Grid.Row="7" FontStyle="Oblique"/>
                <TextBlock Text="More User Convienence Controls Are Planned" FontSize="8" Grid.Row="8" FontWeight="Bold" TextAlignment="Center"/>
            </Grid>
        </Expander>

        <Expander x:Name="testexpander" Grid.Column="1" Header="Test Variables" Height="200" Margin="0,0,0,480" Width="200" IsExpanded="False" Panel.ZIndex="3">
            <Grid Background="#FFE5E5E5">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <TextBox Name="TestPTB1" Grid.Column="0" Text="Mann" Grid.Row="0" FontSize="12" KeyDown="Testbox_TextChanged"/>
                <TextBlock Grid.Column="1" Text="1, Red Province" Grid.Row="0" FontSize="9"/>
                <TextBox Name="TestPTB2" Grid.Column="0" Text="Jan Mayen" FontSize="12" Grid.Row="1" KeyDown="Testbox_TextChanged"/>
                <TextBlock Grid.Column="1" Text="2, Blue Province" Grid.Row="1" FontSize="9"/>
                <TextBox Name="TestPTB3" Grid.Column="0" Text="Jan Mayen" Grid.Row="2" FontSize="12" KeyDown="Testbox_TextChanged"/>
                <TextBlock Grid.Column="1" Text="3, Green Province" Grid.Row="2" FontSize="9"/>
                <TextBox Name="TestPTB4" Grid.Column="0" Text="Mann" FontSize="12" Grid.Row="3" KeyDown="Testbox_TextChanged"/>
                <TextBlock Grid.Column="1" Text="4, Purple Province" Grid.Row="3" FontSize="9"/>
                <TextBox Name="TestPTB5" Grid.Column="0" Text="Pskov" Grid.Row="4" FontSize="12" KeyDown="Testbox_TextChanged"/>
                <TextBlock Grid.Column="1" Text="5, Cyan Province" Grid.Row="4" FontSize="9"/>
                <TextBox Name="TestPTB6" Grid.Column="0" Text="Pskov" FontSize="12" Grid.Row="5" KeyDown="Testbox_TextChanged"/>
                <TextBlock Grid.Column="1" Text="6, Yellow Province" Grid.Row="5" FontSize="9"/>
            </Grid>
        </Expander>

        <Grid x:Name="mapGrid" Margin="16,25,10,10" Background="#FF909090" Grid.Column="1"
              Panel.ZIndex="1">

            <ScrollViewer x:Name="scrollViewer" VerticalScrollBarVisibility="Disabled"
                          HorizontalScrollBarVisibility="Auto" AllowDrop="True">

                <Canvas x:Name="mapCanvas" RenderTransformOrigin="0.5,0.5" MouseWheel="MainWindow_MouseWheel">
                    <Image x:Name="mapBackground" Height="700" Width="1446" Source="/blank_world_map.png"
                           Margin="-250,0,0,0" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                           MouseLeftButtonDown="map_MouseLeftButtonDown"
                           MouseMove="map_MouseMove" MouseLeftButtonUp="map_MouseLeftButtonUp"
                           RenderTransformOrigin="0,0" OverridesDefaultStyle="True" ClipToBounds="True"
                           StretchDirection="Both" MouseDown="map_MouseLeftButtonDown" MouseUp="map_MouseLeftButtonUp">
                    </Image>
                </Canvas>
            </ScrollViewer>
        </Grid>

        <!--Below is the designer setup for testing with pixel reading & layers-->
        <Grid Name="testgrid1" Grid.Column="0" Grid.ColumnSpan="1" Panel.ZIndex="2">
            <Canvas Name="testlayer1">
                <Image x:Name="testimage1" Margin="400,100,0,0" Source="/TestProvince.bmp" RenderOptions.BitmapScalingMode="NearestNeighbor" Height="500" Width="500" Visibility="Visible"/>
            </Canvas>
            <Canvas Name="testlayer2" Grid.Column="0" Grid.ColumnSpan="1" Panel.ZIndex="3" >
                <Image Visibility="Visible" x:Name="testimage2" Margin="400,100,0,0" RenderOptions.BitmapScalingMode="NearestNeighbor" Height="500" Width="500" Source="/TestProvince.bmp"/>
            </Canvas>
        </Grid>

    </Grid>
</Window>
