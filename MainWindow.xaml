<Window
    xmlns:local="clr-namespace:Paradox_Editor"
    xmlns:interfaces="clr-namespace:Paradox_Editor.Interfaces"
    x:Class="Paradox_Editor.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
    
    mc:Ignorable="d"
    Title="Z-22 Paradox Map Editor" Height="700" Width="1200"
    UseLayoutRounding="True" WindowStartupLocation="CenterScreen" Loaded="MainWindow_Load"
    DataContext="{Binding RelativeSource={RelativeSource Self}}">

    <Window.Background>
        <ImageBrush>
            <ImageBrush.ImageSource>
                <BitmapImage UriSource="/Assets/VIC2/Images/main_bg.png"/>
            </ImageBrush.ImageSource>
        </ImageBrush>
    </Window.Background>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="mainWindowGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="6*"/>
            <RowDefinition Height="100*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270*"/>
            <ColumnDefinition Width="955*"/>
        </Grid.ColumnDefinitions>


        <TabControl x:Name="programTabs" Grid.Column="1" Grid.Row="1" Panel.ZIndex="0" Margin="0,0,10,10">
            <TabItem Header="Map Editing">
                <Grid>
                    <local:MapModesControl x:Name="mapModeButtons" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                    Margin="0,0,18,15" Grid.Column="1" Panel.ZIndex="2" Height="64" Width="212" Grid.Row="1"/>

                    <local:MapViewer x:Name="mapViewer" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                    Grid.Column="1" Panel.ZIndex="0" Grid.Row="1" Grid.ColumnSpan="1" Margin="0,0,15,10"/>

                    <!--Province File Interface-->
                    <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Height="400" Width="368" Panel.ZIndex="5" >
                        <behaviors:Interaction.Behaviors>
                            <behaviors:MouseDragElementBehavior ConstrainToParentBounds="True"/>
                        </behaviors:Interaction.Behaviors>
                        <local:ProvinceInterface x:Name="provinceInterface" Visibility="Visible" HorizontalAlignment="Center"  VerticalAlignment="Top"
                        Grid.Column="1" Grid.Row="1" Panel.ZIndex="4" Grid.RowSpan="1" Grid.ColumnSpan="2" Loaded="provinceInterface_Loaded"/>
                    </Grid>

                </Grid>
            </TabItem>
            <TabItem Header="Culture Editing">
                <Grid Background="#FFE5E5E5">
                    <TreeView x:Name="treeView" FontSize="20" >
                        <TreeViewItem Header="germanic" IsSelected="True">
                            <TreeViewItem Header="leader = european"/>
                            <TreeViewItem Header="unit = EuropeanGC"/>
                            <TreeViewItem Header="leader = european"/>
                            <TreeViewItem Header="north_german">
                                <TreeViewItem Header="color = 90,60,60"/>
                                <TreeViewItem Header="first_names">
                                    <TreeViewItem Header="Adelbert"/>
                                </TreeViewItem>
                                <TreeViewItem Header="last_names">
                                    <TreeViewItem Header="Behncke"/>
                                </TreeViewItem>
                            </TreeViewItem>
                            <TreeViewItem Header="saxon">
                                <TreeViewItem Header="color = 0,49,83"/>
                                <TreeViewItem Header="first_names">
                                    <TreeViewItem Header="Adelbert"/>
                                </TreeViewItem>
                                <TreeViewItem Header="last_names">
                                    <TreeViewItem Header="Behncke"/>
                                </TreeViewItem>
                            </TreeViewItem>

                        </TreeViewItem>

                    </TreeView>
                </Grid>
            </TabItem>

            <TabItem Header="Pop Adjuster">
                <Grid Background="#FFE5E5E5">
                    <interfaces:PopAdjuster/>
                </Grid>
            </TabItem>


        </TabControl>



        <Button x:Name="button" Content="SELECT MOD FOLDER" HorizontalAlignment="Center" VerticalAlignment="Top"
        Width="150" Height="25" Click="SelectMasterFolder_Click" Margin="0,12,0,0" Grid.Column="1" Panel.ZIndex="1" Grid.RowSpan="2"/>

        <DataGrid x:Name="fileListView" Margin="20,15,5,10" AlternatingRowBackground="#FFE2E2E2"
                  ItemsSource="{Binding ProvinceData, Mode=TwoWay}" SelectedItem="{Binding SelectedItem}"
                  AutoGenerateColumns="False" CanUserAddRows="False" Visibility="Visible"
                  Grid.Column="0" Grid.ColumnSpan="1"  Grid.RowSpan="2">
            <DataGrid.Columns>
                <DataGridTextColumn x:Name="Column1" Header="ID" Width="40" Binding="{Binding ProvinceID, UpdateSourceTrigger=PropertyChanged}"/>
                <DataGridTextColumn x:Name="Column2" Header="Name" Width="120" Binding="{Binding ProvinceName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <DataGridTemplateColumn x:Name="Column3" Header="Open File" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Open" Height="18" Width="55" Click="OpenFileFromList"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <ComboBox x:Name="GameSelectDropdown"
                  HorizontalAlignment="Left" Grid.Row="0" Grid.Column="1" Margin="15,12,0,0"
                  VerticalAlignment="Top" Width="150" SelectedIndex="0" SelectionChanged="SelectGame" Grid.RowSpan="2" Height="22">
            <ListBoxItem x:Name="Vic2" Content="N/A">
            </ListBoxItem>
            <ListBoxItem Content="Victoria II" FontFamily="18thCentury" FontSize="20" FontWeight="Bold">
                <ListBoxItem.Background>
                    <ImageBrush ImageSource="/Assets/BackgroundSelectVIC2.png" Stretch="Fill"/>
                </ListBoxItem.Background>
            </ListBoxItem>
            <ListBoxItem x:Name="Europa4" Content="Europa Universalis IV" Foreground="White" FontFamily="Italianate" FontSize="14">
                <ListBoxItem.Background>
                    <ImageBrush ImageSource="/Assets/BackgroundSelectEU4.png" Stretch="Fill"/>
                </ListBoxItem.Background>
            </ListBoxItem>
        </ComboBox>


        

        <ComboBox x:Name="ControlMode" HorizontalAlignment="Left" Grid.Column="1" ToolTip="Settings for program control scheme." Margin="178,12,0,0" VerticalAlignment="Top" Width="150" SelectedIndex="0" SelectionChanged="ChangeControlScheme" Grid.RowSpan="2" Height="22">
            <ListBoxItem x:Name="Mode_Classic" Content="Classic"/>
            <ListBoxItem x:Name="Mode_Modern" Content="Modern"/>
            <ListBoxItem x:Name="Mode_PaintDotNet" Content="Paint.NET"/>
        </ComboBox>


    </Grid>
</Window>
