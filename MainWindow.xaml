<Window DataContext="{Binding this}"
    xmlns:local="clr-namespace:Paradox_Editor"
    x:Class="Paradox_Editor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wf="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Z-22 Paradox Map Editor" Height="700" Width="1200" UseLayoutRounding="True" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="mainWindowGrid">
        <Grid.RowDefinitions>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270*"/>
            <ColumnDefinition Width="955*"/>
        </Grid.ColumnDefinitions>
        <Button x:Name="button" Content="Load Filepath" HorizontalAlignment="Left" VerticalAlignment="Top"
        Width="86" Height="27" Click="SelectMasterFolder_Click" Margin="98,0,0,0"/>

        <Canvas Grid.Column="1" Background="#FF494949" Height="50" Width="200" Margin="0,590,-705,0" Panel.ZIndex="2">
            <Button Height="25" Width="30" Click="mapmodeButton_Political_Click" Margin="5,0,0,0" Panel.ZIndex="1" Grid.Column="1" Background="{x:Null}" BorderBrush="{x:Null}">
                <Image x:Name="mapmodeButton_Political" Source="/Preloaded_GFX/VIC2/mapmode_PoliticalOff.png" Stretch="Fill"/>
            </Button>

            <Button Height="25" Width="30" Click="mapmodeButton_Provinces_Click" Margin="35,0,0,0" Panel.ZIndex="1" Grid.Column="1" BorderBrush="{x:Null}" Background="{x:Null}">
                <Image x:Name="mapmodeButton_Provinces" Source="/Preloaded_GFX/VIC2/mapmode_ProvincesOff.png" Stretch="Fill"/>
            </Button>

            <Button Height="25" Width="30" Click="mapmodeButton_Terrain_Click" Margin="65,0,0,0" Panel.ZIndex="1" Grid.Column="1" Background="{x:Null}" BorderBrush="{x:Null}">
                <Image x:Name="mapmodeButton_Terrain" Source="/Preloaded_GFX/VIC2/mapmode_TerrainOff.png" Stretch="Fill"/>
            </Button>

        </Canvas>


        <DataGrid x:Name="fileListView" Margin="0,25,4,0" AlternatingRowBackground="#FFE2E2E2" ItemsSource="{Binding Path=FilePaths}" SelectedItem="{Binding SelectedItem}" AutoGenerateColumns="False" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn/>
                <DataGridTextColumn x:Name="Column1" Header="ID" Width="40" Binding="{Binding ID}"/>
                <DataGridTextColumn x:Name="Column2" Header="Name" Width="105" Binding="{Binding ProvinceName}"/>
                <DataGridTemplateColumn x:Name="Column3" Header="Open File" Width="61">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Open" Height="18" Width="55" Click="button_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <ContentPresenter Margin="0,0,0,660" Content="/provinces.png" Grid.Column="1"/>

        <Grid x:Name="mapGrid" Margin="16,25,10,10" Background="#FF909090" Grid.Column="1"
              Panel.ZIndex="1">

            <ScrollViewer x:Name="scrollViewer" VerticalScrollBarVisibility="Disabled"
                          HorizontalScrollBarVisibility="Auto" AllowDrop="True">

                <Canvas x:Name="mapCanvas" RenderTransformOrigin="0.5,0.5" MouseWheel="MainWindow_MouseWheel">
                    <Image x:Name="mapBackground" Height="700" Width="1446" Source="/blank_world_map.png"
                           Margin="-250,0,0,0" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                           MouseLeftButtonDown="map_MouseLeftButtonDown"
                           MouseMove="map_MouseMove" MouseLeftButtonUp="map_MouseLeftButtonUp"
                           RenderTransformOrigin="0,0" OverridesDefaultStyle="True" ClipToBounds="True"
                           StretchDirection="Both" MouseDown="map_MouseLeftButtonDown" MouseUp="map_MouseLeftButtonUp">
                    </Image>
                </Canvas>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
